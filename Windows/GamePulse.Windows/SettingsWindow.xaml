<Window x:Class="GamePulse.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="游戏脉冲设置" Width="650" Height="760" MinWidth="610" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#FFF5F6FA">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26">
            <TextBlock Text="游戏账号" FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/>

            <Border Background="White" CornerRadius="18" Padding="18" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="米游社 · 原神与崩坏：星穹铁道" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="两个游戏共用主账号" Foreground="#767B88" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="PrimaryStatus" Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold"/>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="完整扫码登录" Padding="14,7" Click="PrimaryLogin_Click"/>
                        <Button Content="退出" Padding="14,7" Margin="8,0,0,0" Click="PrimaryLogout_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="White" CornerRadius="18" Padding="18" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="米游社 · 绝区零" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="可使用另一个米游社账号" Foreground="#767B88" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="ZenlessStatus" Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold"/>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="完整扫码登录" Padding="14,7" Click="ZenlessLogin_Click"/>
                        <Button Content="退出" Padding="14,7" Margin="8,0,0,0" Click="ZenlessLogout_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="White" CornerRadius="18" Padding="18" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="明日方舟 · 森空岛" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="使用森空岛 App 扫码授权" Foreground="#767B88" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="SklandStatus" Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold"/>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="扫码登录" Padding="14,7" Click="SklandLogin_Click"/>
                        <Button Content="退出" Padding="14,7" Margin="8,0,0,0" Click="SklandLogout_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="White" CornerRadius="18" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="鸣潮 · 库街区" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="手机号短信验证码登录" Foreground="#767B88" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="KuroStatus" Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="手机号" VerticalAlignment="Center"/>
                        <TextBox x:Name="PhoneBox" Grid.Column="1" Padding="8,6"/>
                        <Button Grid.Column="2" Content="发送验证码" Padding="12,7" Margin="8,0,0,0" Click="SendSms_Click"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="短信验证码" VerticalAlignment="Center"/>
                        <TextBox x:Name="SmsBox" Grid.Column="1" Padding="8,6"/>
                        <Button Grid.Column="2" Content="登录" Padding="23,7" Margin="8,0,0,0" Click="KuroLogin_Click"/>
                    </Grid>
                    <TextBlock x:Name="KuroMessage" Foreground="#E44B4B" TextWrapping="Wrap" Margin="100,8,0,0"/>
                    <Button Content="退出库街区" HorizontalAlignment="Left" Padding="12,6" Margin="100,8,0,0" Click="KuroLogout_Click"/>
                </StackPanel>
            </Border>

            <TextBlock Text="刷新与高级数据源" FontSize="20" FontWeight="Bold" Margin="0,10,0,12"/>
            <Border Background="White" CornerRadius="18" Padding="18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="自动刷新（分钟）" VerticalAlignment="Center"/>
                        <TextBox x:Name="RefreshBox" Grid.Column="1" Padding="8,6"/>
                    </Grid>
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="数据桥地址（可选）" VerticalAlignment="Center"/>
                        <TextBox x:Name="BridgeUrlBox" Grid.Column="1" Padding="8,6"/>
                    </Grid>
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Bearer Token" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="BridgeTokenBox" Grid.Column="1" Padding="8,6"/>
                    </Grid>
                    <TextBlock Text="账号凭据使用 Windows 当前用户加密保存，不写入日志。数据桥留空时直接读取官方社区。"
                               Foreground="#767B88" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,8">
                <Button Content="取消" Padding="18,8" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="保存并刷新" Padding="18,8" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
